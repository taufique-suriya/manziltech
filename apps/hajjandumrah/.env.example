# Links back to the ManzilTech hub and the other products. Copy to .env.local to override; defaults are the local dev ports.
NEXT_PUBLIC_HUB_URL=http://localhost:3000
NEXT_PUBLIC_HAJJANDUMRAH_URL=http://localhost:3001
NEXT_PUBLIC_BOOKINGS_URL=http://localhost:3002
NEXT_PUBLIC_STUDIO_URL=http://localhost:3003

# Deployment environment: 'stg' or 'prd'. Only 'prd' lets search engines index the site.
NEXT_PUBLIC_SITE_ENV=
