# Links back to the ManzilTech hub. Copy to .env.local to override; defaults are the local dev ports.
NEXT_PUBLIC_HUB_URL=http://localhost:3000

# Deployment environment: 'stg' or 'prd'. Only 'prd' lets search engines index the site.
NEXT_PUBLIC_SITE_ENV=

# Contact details shown on the contact page. Empty values use the placeholders in packages/ui/src/contact.ts.
# Phone and WhatsApp numbers in international format (+919876543210); emails may be comma-separated.
NEXT_PUBLIC_CONTACT_BOOKINGS_EMAIL=
NEXT_PUBLIC_CONTACT_BOOKINGS_PHONE=
NEXT_PUBLIC_CONTACT_BOOKINGS_WHATSAPP=
# One emergency number for the hub and every product.
NEXT_PUBLIC_CONTACT_EMERGENCY_PHONE=
