# Store text with LF in the repo and check it out with LF on every OS,
# so line endings never show up as changes. This overrides core.autocrlf.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.dll binary
*.exe binary
